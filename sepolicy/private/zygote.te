# Zygote rules for Android 16 compatibility
# We cannot allow dyntransition or direct system_data_file writes due to neverallows.
# These rules allow zygote to find the services it needs to start apps correctly.

allow zygote { 
  system_server 
  surfaceflinger 
  servicemanager 
}:binder { call transfer };

allow { 
  system_server 
  surfaceflinger 
  servicemanager 
} zygote:binder { call transfer };

# Allow zygote to use FDs and sockets from services it interacts with
allow zygote surfaceflinger:fd use;
allow zygote { system_server surfaceflinger }:unix_stream_socket { read write };

# Allow zygote to find services
allow zygote { 
  activity_service 
  surfaceflinger_service 
  activity_task_service
  device_state_service
  role_service
  legacy_permission_service
  statusbar_service
  launcherapps_service
  content_capture_service
  trust_service
  usagestats_service
  vibrator_manager_service
  media_session_service
  uimode_service
  package_service
  network_management_service
  fingerprint_service
  face_service
  hint_service
  wallpaper_service
  webviewupdate_service
  netstats_service
  protolog_configuration_service
}:service_manager find;

# Allow zygote to write to traced (Perfetto)
allow zygote traced:unix_stream_socket connectto;
allow zygote traced_producer_socket:sock_file write;

# NetworkStack transition fix
allow zygote network_stack:process { transition dyntransition };
allow zygote network_stack:binder { call transfer };
allow network_stack zygote:binder { call transfer };
